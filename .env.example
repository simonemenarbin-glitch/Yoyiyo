PORT=3000
APP_BASE_URL=http://localhost:3000

# Create these in https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Must exactly match the redirect URI configured in TikTok Developer Portal.
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# Required for direct posting. TikTok must approve the video.publish scope.
TIKTOK_SCOPES=user.info.basic,video.publish

# Local token cache. Keep this outside git.
TOKEN_STORE_PATH=.data/tiktok-tokens.json

# Change this in production.
COOKIE_SECRET=replace-with-a-long-random-string
