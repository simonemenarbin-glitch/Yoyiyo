{
  "name": "rotta-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && NODE_OPTIONS='--max-old-space-size=1536' next build --webpack",
    "start": "npx prisma migrate deploy && npx tsx prisma/seed.ts && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test:catalog": "node scripts/test_catalog_contracts.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "imapflow": "^1.0.191",
    "lucide-react": "^1.66.0",
    "mailparser": "^3.14.1",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.1"
  }
}
